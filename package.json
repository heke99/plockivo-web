{
  "name": "plockivo-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "standard": "python3 tools/engineering/check_standard.py --project .",
    "verify": "npm run standard && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.1.12",
    "@supabase/ssr": "0.8.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  }
}
